# Auth0 Configuration
# Get these values from your Auth0 dashboard
# https://manage.auth0.com/

REACT_APP_AUTH0_DOMAIN=your-auth0-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your_client_id_here
REACT_APP_AUTH0_AUDIENCE=https://your-api-audience

# Example:
# REACT_APP_AUTH0_DOMAIN=dev-12345678.us.auth0.com
# REACT_APP_AUTH0_CLIENT_ID=abcdefghijklmnopqrstuvwxyz123456
# REACT_APP_AUTH0_AUDIENCE=https://mcshef-api.example.com
