# Okta Configuration
# Get these values from your Okta developer dashboard
# https://developer.okta.com

REACT_APP_OKTA_CLIENT_ID=your_client_id_here
REACT_APP_OKTA_ISSUER=https://your-okta-domain/oauth2/default

# Example:
# REACT_APP_OKTA_CLIENT_ID=0oa1b2c3d4e5f6g7h8i9
# REACT_APP_OKTA_ISSUER=https://dev-12345678.okta.com/oauth2/default
